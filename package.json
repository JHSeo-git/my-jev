{
  "name": "my-jev",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts ./tests",
    "examples": "bun scripts/run-examples.ts",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "ai": "7.0.107",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "typescript": "^5"
  }
}
